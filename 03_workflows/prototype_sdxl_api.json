{
  "_comment": "PROTOTYPE - SDXL. Same topology as the production FLUX graph. Nodes 2 (character LoRA) and 5-8 (ControlNet staging) are bypassed automatically when a panel supplies no LoRA or no scene reference, so one template serves solo, multi-character and action panels.",

  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "%%CHECKPOINT%%" },
    "_meta": { "title": "1 - Checkpoint" }
  },

  "2": {
    "class_type": "LoraLoader",
    "inputs": {
      "lora_name": "%%LORA1%%",
      "strength_model": %%LORA1_WEIGHT%%,
      "strength_clip": %%LORA1_WEIGHT%%,
      "model": ["1", 0],
      "clip": ["1", 1]
    },
    "_meta": { "title": "2 - Character LoRA (auto-bypassed when unset)" }
  },

  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "%%POSITIVE%%", "clip": ["2", 1] },
    "_meta": { "title": "3 - Positive: style, environment, identity, action, camera" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "%%NEGATIVE%%", "clip": ["2", 1] },
    "_meta": { "title": "4 - Negative" }
  },

  "5": {
    "class_type": "LoadImage",
    "inputs": { "image": "%%CONTROL_IMAGE%%", "upload": "image" },
    "_meta": { "title": "5 - Scene staging reference" }
  },
  "6": {
    "class_type": "DepthAnythingV2Preprocessor",
    "inputs": { "image": ["5", 0] },
    "_meta": { "title": "6 - Depth map: the set the panel is staged in" }
  },
  "7": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "%%CONTROLNET%%" },
    "_meta": { "title": "7 - ControlNet" }
  },
  "8": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "strength": %%CN_STRENGTH%%,
      "start_percent": 0.0,
      "end_percent": %%CN_END%%,
      "positive": ["3", 0],
      "negative": ["4", 0],
      "control_net": ["7", 0],
      "image": ["6", 0]
    },
    "_meta": { "title": "8 - Apply staging. end_percent releases control so the action prompt still drives the character (auto-bypassed when the scene has no reference)" }
  },

  "9": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": %%WIDTH%%, "height": %%HEIGHT%%, "batch_size": 1 },
    "_meta": { "title": "9 - Panel size" }
  },
  "10": {
    "class_type": "KSampler",
    "inputs": {
      "seed": %%SEED%%,
      "steps": %%STEPS%%,
      "cfg": %%CFG%%,
      "sampler_name": "%%SAMPLER%%",
      "scheduler": "%%SCHEDULER%%",
      "denoise": 1.0,
      "model": ["2", 0],
      "positive": ["8", 0],
      "negative": ["8", 1],
      "latent_image": ["9", 0]
    },
    "_meta": { "title": "10 - Sampler. Seed comes from the scene so panels match" }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["10", 0], "vae": ["1", 2] },
    "_meta": { "title": "11 - Decode" }
  },
  "12": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "panel", "images": ["11", 0] },
    "_meta": { "title": "12 - Save panel" }
  }
}
