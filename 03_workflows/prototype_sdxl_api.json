{
  "_comment": "PROTOTYPE — SDXL. Proves the architecture on a 4 GB card before renting FLUX hardware. Same topology as the production FLUX graph: style + scene + identity conditioning, ControlNet staging, character LoRA. Swap CheckpointLoader for UNETLoader/DualCLIPLoader and this becomes the FLUX graph.",

  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "%%CHECKPOINT%%" },
    "_meta": { "title": "1 · SDXL checkpoint" }
  },

  "2": {
    "class_type": "LoraLoader",
    "inputs": {
      "lora_name": "%%LORA1%%",
      "strength_model": %%LORA1_WEIGHT%%,
      "strength_clip": %%LORA1_WEIGHT%%,
      "model": ["1", 0],
      "clip": ["1", 1]
    },
    "_meta": { "title": "2 · Character LoRA — BYPASS when no lead in panel" }
  },

  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "%%POSITIVE%%", "clip": ["2", 1] },
    "_meta": { "title": "3 · Positive — style, environment, identity, action, camera" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "%%NEGATIVE%%", "clip": ["2", 1] },
    "_meta": { "title": "4 · Negative" }
  },

  "5": {
    "class_type": "LoadImage",
    "inputs": { "image": "%%DEPTH_REF%%", "upload": "image" },
    "_meta": { "title": "5 · Scene staging reference — locks background geometry" }
  },
  "6": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "%%CONTROLNET%%" },
    "_meta": { "title": "6 · ControlNet" }
  },
  "7": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "strength": %%CN_STRENGTH%%,
      "start_percent": 0.0,
      "end_percent": 0.85,
      "positive": ["3", 0],
      "negative": ["4", 0],
      "control_net": ["6", 0],
      "image": ["5", 0]
    },
    "_meta": { "title": "7 · Apply staging — BYPASS for a panel with no scene lock" }
  },

  "8": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": %%WIDTH%%, "height": %%HEIGHT%%, "batch_size": 1 },
    "_meta": { "title": "8 · Panel size" }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "seed": %%SEED%%,
      "steps": %%STEPS%%,
      "cfg": %%CFG%%,
      "sampler_name": "%%SAMPLER%%",
      "scheduler": "%%SCHEDULER%%",
      "denoise": 1.0,
      "model": ["2", 0],
      "positive": ["7", 0],
      "negative": ["7", 1],
      "latent_image": ["8", 0]
    },
    "_meta": { "title": "9 · Sampler — seed comes from the scene, so panels match" }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["9", 0], "vae": ["1", 2] },
    "_meta": { "title": "10 · Decode" }
  },
  "11": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "panel", "images": ["10", 0] },
    "_meta": { "title": "11 · Save panel" }
  }
}
